# Multi-stage build for unified Skaftin application
FROM node:22-alpine AS base

# Install system dependencies
RUN apk add --no-cache \
    postgresql-client \
    curl \
    git \
    python3 \
    make \
    g++

# Set working directory
WORKDIR /app

# Copy root package files
COPY package*.json ./
COPY tsconfig.json ./

# Install root dependencies
RUN npm ci

# Copy backend source
COPY src/backend ./src/backend
COPY src/Server.ts ./src/

# Build backend TypeScript
RUN npm run build

# Frontend build stage
FROM node:22-alpine AS frontend-builder

# Set working directory
WORKDIR /app

# Copy frontend package files
COPY src/frontend/package*.json ./src/frontend/

# Install frontend dependencies
RUN cd src/frontend && npm ci

# Copy frontend source
COPY src/frontend ./src/frontend
COPY tsconfig.json ./

# Build frontend
RUN cd src/frontend && npm run build

# Production stage
FROM node:22-alpine AS production

# Install system dependencies
RUN apk add --no-cache \
    postgresql-client \
    curl \
    git \
    python3 \
    make \
    g++

# Set working directory
WORKDIR /app

# Copy root package files
COPY package*.json ./
COPY tsconfig.json ./

# Install only production dependencies
RUN npm ci --only=production

# Copy built backend from base stage
COPY --from=base /app/dist ./dist
COPY --from=base /app/src/backend ./src/backend
COPY --from=base /app/src/Server.ts ./src/

# Copy built frontend from frontend-builder stage
COPY --from=frontend-builder /app/src/frontend/dist ./src/frontend/dist
COPY --from=frontend-builder /app/src/frontend/package*.json ./src/frontend/

# Install frontend production dependencies
RUN cd src/frontend && npm ci --only=production

# Copy .env files
COPY .env.example ./.env.example
COPY .env* ./

# Install PM2 for process management
RUN npm install -g pm2

# Copy PM2 ecosystem configuration
COPY ecosystem.config.js ./

# Create logs directory
RUN mkdir -p /app/logs

# Expose both ports
EXPOSE 3005 4005

# Health check for both services
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:4005/api/health && curl -f http://localhost:3005 || exit 1

# Start both services with PM2
CMD ["pm2-runtime", "start", "ecosystem.config.js"]
