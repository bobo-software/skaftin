# PORT CONNECTION
FRONTEND_PORT=3005
FRONTEND_URL=http://localhost:3005
BACKEND_PORT=4007
BACKEND_URL=http://localhost:4007

# CLIENT APP CORS (Optional - for external client applications)
# Add comma-separated origins that should be allowed to access the API
# Example: CLIENT_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Leave empty to allow all origins (API key auth required anyway)
CLIENT_ALLOWED_ORIGINS=

# IMPORTANT: Set VITE_API_URL in frontend/.env for production only
# Development: Leave VITE_API_URL empty to use Vite proxy (avoids CORS issues)
# Production: VITE_API_URL=https://skaftinplatform.bobosoftware.co.za
# 
# For MCP integration, the Cursor modal will show:
# - Development: http://localhost:4006 (direct backend)
# - Production: Your configured VITE_API_URL

