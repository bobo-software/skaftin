# Server Configuration
PORT=4006
NODE_ENV=development

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3006,http://localhost:3000,http://127.0.0.1:3006,http://coolify.bobosoftware.co.za:3006

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5440
POSTGRES_DB=skaftin_db
POSTGRES_USER=skaftin_user
POSTGRES_PASSWORD=skaftin_password
DB_NAME=skaftin_db
DB_USER=skaftin_user
DB_PASSWORD=skaftin_password

# MinIO Configuration
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=skaftin_minio
MINIO_ROOT_PASSWORD=skaftin_password
MINIO_ACCESS_KEY=skaftin_minio
MINIO_SECRET_KEY=skaftin_password
MINIO_BUCKET=skaftin-files

# Add your other environment variables here
# DATABASE_URL=your_database_url
# JWT_SECRET=your_jwt_secret
# API_KEY=your_api_key