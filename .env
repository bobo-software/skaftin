# Server Configuration
PORT=4006
NODE_ENV=production

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=skaftin_db
DB_USER=skaftin_user
DB_PASSWORD=skaftin_password
DATABASE_URL=postgresql://skaftin_user:skaftin_password@postgres:5432/skaftin_db

# MinIO Configuration
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=skaftin_minio
MINIO_SECRET_KEY=skaftin_minio_password
MINIO_BUCKET=skaftin-files
MINIO_URL=http://minio:9000

# Add your other environment variables here
# JWT_SECRET=your_jwt_secret
# API_KEY=your_api_key